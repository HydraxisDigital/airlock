{
  "id": "rust",
  "label": "Rust",
  "vscode_extensions": [
    "rust-lang.rust-analyzer",
    "tamasfe.even-better-toml",
    "vadimcn.vscode-lldb"
  ],
  "audit_command": "cargo audit && cargo deny check",
  "tree_command": "cargo tree",
  "remote_env": {},
  "language_version": {
    "name": "rust",
    "token": "RUST_VERSION",
    "default": "1.94.0",
    "supported": [
      { "version": "1.92.0", "image": "2.0.6-bookworm" },
      { "version": "1.93.0", "image": "2.0.7-bookworm" },
      { "version": "1.94.0", "image": "2.0.9-bookworm" }
    ]
  }
}
